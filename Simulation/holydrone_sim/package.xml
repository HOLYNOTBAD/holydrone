<?xml version="1.0"?>
<package format="2">
  <name>holydrone_sim</name>
  <version>1.0.0</version>
  <description>Portable Gazebo Classic and PX4 SITL assets for Holydrone.</description>

  <maintainer email="holynotbad@users.noreply.github.com">HOLYNOTBAD</maintainer>
  <license>See repository and third-party license notices</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-nose</test_depend>

  <export/>
</package>
